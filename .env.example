# Copy to .env.local and fill in. NEVER commit real values.
# Leave both blank to run in local-only mode (browser storage, no auth).

# Supabase project URL, e.g. https://<project-ref>.supabase.co
VITE_SUPABASE_URL=
# Supabase *publishable/anon* key only. Never put the service-role key in any VITE_ variable:
# everything prefixed VITE_ is bundled into the browser.
VITE_SUPABASE_ANON_KEY=
