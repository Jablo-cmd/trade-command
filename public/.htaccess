# Trade Command: static hosting on Apache (e.g. cPanel subdomain trade.aurisnexus.co.za).
# The app uses hash routing (#/accounts), so no SPA rewrite is needed.

Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
RewriteEngine On
# Own rules only: do not inherit the main site's redirects if this folder sits inside it.
RewriteOptions IgnoreInherit
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set X-Frame-Options "DENY"
  # Private console: keep it out of search engines.
  Header set X-Robots-Tag "noindex, nofollow"

  # App shell and service worker must always be revalidated so updates show up.
  <FilesMatch "^(index\.html|sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Hashed build assets never change: cache for a year.
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/svg+xml .svg
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/manifest+json image/svg+xml
</IfModule>
